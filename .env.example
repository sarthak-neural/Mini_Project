# ============================================================================
# Restaurant Inventory AI - Environment Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control - it contains sensitive data
# ============================================================================

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=development
DEBUG=False
SECRET_KEY=your-secret-key-here-use-min-32-chars-in-production

# ============================================================================
# Database Configuration
# ============================================================================
# For development (SQLite):
DATABASE_URL=sqlite:///restaurant_ai.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/restaurant_ai
# DB_USER=restaurant_user
# DB_PASSWORD=your_secure_password
# DB_NAME=restaurant_ai
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# Redis Cache Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ============================================================================
# Email Configuration (Gmail SMTP Example)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@restaurantai.com

# ============================================================================
# Twilio Configuration (SMS OTP)
# ============================================================================
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# OAuth Configuration
# ============================================================================
# Google OAuth
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
# Get from: https://portal.azure.com/
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Apple OAuth
# Get from: https://developer.apple.com/
APPLE_CLIENT_ID=com.restaurantai
APPLE_CLIENT_SECRET=your-apple-client-secret

# ============================================================================
# Application Settings
# ============================================================================
# Session timeout in hours
SESSION_TIMEOUT=24

# Enable profiling for performance debugging
ENABLE_PROFILING=False

# Strict production configuration checks
STRICT_PRODUCTION_CONFIG=False

# ============================================================================
# Security Headers & Protection
# ============================================================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Sentry Error Tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# Testing Configuration
# ============================================================================
# Used when FLASK_ENV=testing
TEST_DATABASE_URL=sqlite:///:memory:
